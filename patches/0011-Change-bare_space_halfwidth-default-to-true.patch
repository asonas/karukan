From ac5e5b983361c8c41f4c88f9bcce60de2fdb9860 Mon Sep 17 00:00:00 2001
From: Yuya Fujiwara <hzw1258@gmail.com>
Date: Fri, 3 Jul 2026 23:25:02 +0900
Subject: [PATCH 11/17] Change bare_space_halfwidth default to true

Bare Space in Empty hiragana mode now commits a half-width ASCII space by
default, aligning with modern input method conventions. Full-width space
remains accessible via Ctrl+Space.

Updated default.toml, the settings test, and README documentation to reflect
this new default behavior.
---
 docs/configuration.md                  | 2 +-
 docs/key-bindings.md                   | 2 +-
 karukan-im/core/config/default.toml    | 8 ++++----
 karukan-im/core/src/config/settings.rs | 8 ++++----
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/docs/configuration.md b/docs/configuration.md
index ce96fca..b7fc21c 100644
--- a/docs/configuration.md
+++ b/docs/configuration.md
@@ -40,7 +40,7 @@ digit = "half"                 # 0-9
 [keys]
 ctrl_space_fullwidth = true    # Ctrl+Space で全角スペースを入力（既定ON。OFFにするとOSへ素通し）
 shift_space_halfwidth = false  # Shift+Space で半角スペースを入力（既定OFF）
-bare_space_halfwidth = false   # 何も入力していないときの Space を半角にする（既定OFF＝全角）
+bare_space_halfwidth = true    # 何も入力していないときの Space を半角にする（既定ON）
 ```
 
 `model` / `light_model` に指定できるモデルIDは以下です（指定したモデルは初回利用時にHugging Faceから自動ダウンロードされます）。設定変更後はfcitx5の再起動（macOSは `killall KarukanIME`）で反映されます。
diff --git a/docs/key-bindings.md b/docs/key-bindings.md
index c5d6e46..a5426d8 100644
--- a/docs/key-bindings.md
+++ b/docs/key-bindings.md
@@ -22,7 +22,7 @@ Karukan のキーバインド一覧です。共通キーバインドは Linux (f
 | Ctrl+K | カタカナモードに切り替え |
 | Ctrl+I | 変換を開始して🤖AI候補のビューを直接開く |
 | Ctrl+T / Ctrl+R | 変換を開始してソース絞り込みビューへ（Ctrl+T は📝学習から、Ctrl+R は🔄記号変換から） |
-| Space（何も入力していないとき） | 全角スペースを入力。`bare_space_halfwidth = true` のとき半角スペース（全角は Ctrl+Space で入力可）。既定は全角 |
+| Space（何も入力していないとき） | 半角スペースを入力（既定）。全角は Ctrl+Space。`bare_space_halfwidth = false` にすると全角スペースになる |
 | Ctrl+Space | 全角スペースを入力（`ctrl_space_fullwidth = true` のとき有効。既定は有効） |
 | Shift+Space | 半角スペースを入力（`shift_space_halfwidth = true` のとき有効。入力中は確定してから半角スペース。既定は無効） |
 
diff --git a/karukan-im/core/config/default.toml b/karukan-im/core/config/default.toml
index a14a087..5da65c9 100644
--- a/karukan-im/core/config/default.toml
+++ b/karukan-im/core/config/default.toml
@@ -106,7 +106,7 @@ ctrl_space_fullwidth = true
 # false では素の Space と同じ挙動のまま。
 shift_space_halfwidth = true
 # 素の Space を Empty 状態のひらがなモードで半角スペースにする。
-# true にすると、ひらがなモードでの素の Space が全角 `　` ではなく
-# 半角スペースをコミットする。false（既定）では全角 `　` をコミットし、
-# 日本語 IME の慣習に従う（全角スペースは Ctrl+Space でも入力できる）。
-bare_space_halfwidth = false
+# true（既定）では、ひらがなモードでの素の Space が全角 `　` ではなく
+# 半角スペースをコミットする（全角スペースは Ctrl+Space で入力できる）。
+# false にすると全角 `　` をコミットし、日本語 IME の慣習に従う。
+bare_space_halfwidth = true
diff --git a/karukan-im/core/src/config/settings.rs b/karukan-im/core/src/config/settings.rs
index 1d046fe..c68c567 100644
--- a/karukan-im/core/src/config/settings.rs
+++ b/karukan-im/core/src/config/settings.rs
@@ -466,11 +466,11 @@ shift_space_halfwidth = true
     }
 
     #[test]
-    fn test_keys_default_bare_space_halfwidth_is_off() {
-        // The bundled default keeps the Japanese-IME convention: bare Space
-        // commits a full-width `　`, so `bare_space_halfwidth` is off.
+    fn test_keys_default_bare_space_halfwidth_is_on() {
+        // This branch's bundled default makes the bare Space commit a
+        // half-width ASCII space (the full-width `　` stays on Ctrl+Space).
         let settings = Settings::default();
-        assert!(!settings.keys.bare_space_halfwidth);
+        assert!(settings.keys.bare_space_halfwidth);
     }
 
     #[test]
