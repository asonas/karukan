+/// First `Commit` action's text, if any.
+fn live_commit_text_of(result: &EngineResult) -> Option<String> {
+    result.actions.iter().find_map(|a| match a {
+        EngineAction::Commit(t) => Some(t.clone()),
+        _ => None,
+    })
+}
