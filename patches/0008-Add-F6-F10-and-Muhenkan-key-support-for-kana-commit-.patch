+// --- ヘルパー ---
+
+fn type_str(engine: &mut InputMethodEngine, s: &str) {
+    for ch in s.chars() {
+        engine.process_key(&press(ch));
+    }
+}
+
+fn commit_text(result: &EngineResult) -> Option<String> {
+    result.actions.iter().find_map(|a| {
+        if let EngineAction::Commit(text) = a {
+            Some(text.clone())
+        } else {
+            None
+        }
+    })
+}
